# Server-side only. Never expose this value to frontend environment variables.
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_FRONTEND_URL=http://localhost:5173
APP_OAUTH_SECURE_COOKIE=false
# RAG retrieval tuning (Phase 1 + Phase 2A hybrid). No secrets; safe to keep defaults.
APP_RAG_RETRIEVAL_CANDIDATE_LIMIT=20
APP_RAG_FINAL_CONTEXT_LIMIT=6
APP_RAG_SIMILARITY_THRESHOLD=0.65
APP_RAG_KEYWORD_THRESHOLD=0.5
APP_RAG_MAX_CHUNKS_PER_DOCUMENT=3
# Phase 2A hybrid retrieval: initial defaults, not tuned. Set to false to restore pure vector search.
APP_RAG_KEYWORD_SEARCH_ENABLED=true
APP_RAG_SEMANTIC_WEIGHT=0.7
APP_RAG_KEYWORD_WEIGHT=0.3
APP_RAG_WEB_FALLBACK_ENABLED=false
APP_RAG_WEB_RESULT_LIMIT=5